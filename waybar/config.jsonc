{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "custom/startmenu",
    "hyprland/window",
    "mpris"
  ],
  "modules-center": [
    "network",
    "memory",
    "cpu",
    "hyprland/workspaces",
    "custom/gpu",
    "disk",
    "clock"
  ],
  "modules-right": [
    "tray",
    // "custom/connections",
    "custom/podman",
    "idle_inhibitor",
    "custom/temperature",
    // "temperature",
    "bluetooth",
    "custom/dualsense",
    "pulseaudio",
    "custom/notification",
    // "battery", removed: crashes waybar (0.15) when a BT/virtual controller battery disappears
    "custom/exit"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    // 1-5 craft colours (1 = strong blue), 6-10 Tracy brothers' sash colours
    "format-icons": {
      "1": "<span color='#3A7FD0'>1</span>",
      "2": "<span color='#5BA83A'>2</span>",
      "3": "<span color='#E2431E'>3</span>",
      "4": "<span color='#F5C518'>4</span>",
      "5": "<span color='#D9B45A'>5</span>",
      "6": "<span color='#8EC9EE'>6</span>",   // Scott  - light blue
      "7": "<span color='#FBE38E'>7</span>",   // Virgil - pale yellow
      "8": "<span color='#FFFFFF'>8</span>",   // Alan   - white
      "9": "<span color='#F59A3C'>9</span>",   // Gordon - amber-orange
      "10": "<span color='#B79BD6'>10</span>"  // John   - lilac
    },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },

  "clock": {
    "format": " {:%H:%M}",
    "tooltip": true,
    "tooltip-format": "<big>{:%A, %d.%B %Y }</big><tt><small>{calendar}</small></tt>"
  },

  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 24,
    "separate-outputs": false
  },

  "mpris": {
    // "format": "{player_icon} {dynamic}",
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} {title} - {artist}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵",
      "spotify": " ",
      "firefox": "󰈹"
    },
    "status-icons": {
      "paused": "⏸"
    },
    // "ignored-players": ["firefox"],
    "max-length": 32
  },

  "memory": {
    "interval": 5,
    "format": " {}%",
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "cpu": {
    "interval": 5,
    "format": " {usage:2}%",
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "disk": {
    "format": " {free}",
    "tooltip": true
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": " {bandwidthDownBits}",
    "format-wifi": " {bandwidthDownBits}",
    "format-disconnected": "󰤮",
    "interval": 2,
    "tooltip": false,
    "on-click": "kitty -e btop"
  },

  "tray": {
    "spacing": 12
  },

  "pulseaudio": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    // left: device switcher menu, right: full mixer, middle: mute
    "on-click": "~/.config/scripts/audio-output.sh",
    "on-click-right": "pavucontrol",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "custom/gpu": {
    "format": "  : {}  ",
    "interval": 2,
    // "exec": "nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits | awk -F',' '{ printf \"%s%% %sMiB/%sMiB\", $1, $2, $3 }'"
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk -F',' '{ printf \"%s%%\", $1 }'"
  },

  "custom/exit": {
    "tooltip": false,
    "format": "⏻",
    "on-click": "sleep 0.1 && wlogout"
  },

  "custom/startmenu": {
    // icon is the International Rescue roundel, drawn via CSS (assets/international-rescue.svg)
    "tooltip": true,
    "tooltip-format": "International Rescue",
    "format": " ",
    "on-click": "pidof wofi || wofi --show drun"
  },

  "custom/connections": {
    "exec": "~/.config/scripts/get_connections.sh",
    "return-type": "json",
    "format": "{text}",
    "interval": 10
  },

  "custom/podman": {
    "exec": "~/.config/scripts/podman-status.sh",
    "interval": 10,
    "return-type": "json",
    "tooltip": true,
    "format": "{icon}  {text}",
    "format-icons": [
      "󰅚", "", ""
    ],
  },

  "custom/dualsense": {
    "exec": "~/.config/scripts/dualsense.sh",
    "interval": 10,
    "return-type": "json",
    "format": "󰊴{icon}{text}",
    "format-icons": [
      "", " 󰁻", " 󰁽", " 󰁿", " 󰂁", " 󰁹"
    ],
  },

  "custom/temperature": {
    "exec": "~/.config/scripts/temps_overview.sh",
    "interval": 30,
    "return-type": "json",
    "tooltip": true,
    "format": " {text}󰔄",
    // "tooltip-format": "{text}",
  }, 

  // "temperature": {
  //   "thermal-zone": 1,
  //   // "hwmon-path": ["/sys/class/hwmon/hwmon2/temp1_input", "/sys/class/thermal/thermal_zone0/temp"],
  //   // "critical-threshold": 80,
  //   // "format-critical": "{temperatureC}°C ",
  //   "format": "{temperatureC}°C ",
  //   "tooltip-format": "{text}",
  // },

  "bluetooth": {
    "format": " {status}",
    "format-on": "",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    // "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "~/.config/scripts/bluetooth-menu.sh toggle", // eww popup (also SUPER+SHIFT+B)
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    },
    "tooltip": true
  },

  "custom/notification": {
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "<span foreground='#D7262E'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='#D7262E'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='#D7262E'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='#D7262E'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    // mako: left = show last, middle = dismiss all, right = toggle do-not-disturb
    "exec": "~/.config/scripts/mako-status.sh",
    "interval": 2,
    "signal": 8,
    "tooltip": true,
    "on-click": "makoctl restore; pkill -RTMIN+8 waybar",
    "on-click-middle": "makoctl dismiss -a; pkill -RTMIN+8 waybar",
    "on-click-right": "makoctl mode -t do-not-disturb; pkill -RTMIN+8 waybar",
    "escape": true
  }
}

