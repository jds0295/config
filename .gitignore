!hypr/**
!kitty/**
!mako/**
!nixos/**
!nvim/**
!scripts/**
!sketchybar/**
!skhd/**
!tmux/**
!wal/templates/**
!waybar/**
!wofi/**
!yabai/**
!zshrc/**

# ignore
nvim/lazy-lock.json
